# .env —— 部署配置（复制为 .env 后按需修改；deploy.sh 会自动生成随机值）
# 数据库名 / 用户（默认即可）
PGDATABASE=marketpos
PGUSER=marketpos
# ⚠️ 必改：数据库密码（随机长字符串）
PGPASSWORD=改成强密码
# ⚠️ 必改：登录会话签名密钥（随机长字符串；不设则每次重启都要重新登录）
AUTH_SECRET=改成随机密钥
# ⚠️ 首次建号密钥：登录页「首次建号」需要填它（防公网扫描抢注）
SETUP_KEY=改成随机串
# 对外端口（默认 80；启用 HTTPS 域名时 deploy.sh 会自动改为 8080）
WEB_PORT=80
# 域名（仅 HTTPS 模式需要；A 记录先解析到服务器 IP）
# DOMAIN=pos.example.com
